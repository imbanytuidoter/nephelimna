[Unit]
Description=Nephelimna table service: keeper, bots, faucet and RPC proxy
After=network-online.target
Wants=network-online.target

[Service]
User=nephelimna
WorkingDirectory=/srv/nephelimna/services/bots
EnvironmentFile=/etc/nephelimna/sepolia.env
EnvironmentFile=/etc/nephelimna/table.env
ExecStart=/usr/bin/env node --import tsx src/table/main.ts
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
