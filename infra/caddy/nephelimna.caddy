nephelimna.imbanytui.xyz {
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/wasm*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
			header Content-Type model/gltf-binary*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' data: blob: https://relayer.testnet.zama.org https://*.s3.eu-west-1.amazonaws.com https://*.s3.amazonaws.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noindex"
		-Server
	}

	@sea path /sea /sea/*
	header @sea Cross-Origin-Opener-Policy "same-origin"
	header @sea Cross-Origin-Embedder-Policy "credentialless"

	handle_path /sea/api/* {
		request_body {
			max_size 256KB
		}
		@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		handle @cloudflare {
			reverse_proxy 127.0.0.1:3430 {
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:3430 {
				header_up X-Forwarded-For {remote_host}
			}
		}
	}

	@legacy not path / /index.html /docs /docs/* /site/* /sea /sea/* /ocean /ocean/* /robots.txt
	redir @legacy /sea/ 302

	root * /var/www/nephelimna/current
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=86400"
	@pages not path /_next/static/* /assets/*
	header @pages Cache-Control "no-cache"
	try_files {path} {path}.html {path}/index.html
	@glb path *.glb
	header @glb Content-Type model/gltf-binary
	@webm path *.webm
	header @webm >Content-Type video/webm
	file_server
}
